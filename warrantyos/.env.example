# Copy this file to .env and adjust as needed. Never commit the real .env.

ENV=development

# --- Database ---
# If using docker-compose, this is set automatically for the backend container.
# If running the backend directly on your machine (no Docker), use this instead:
DATABASE_URL=postgresql+psycopg2://warrantyos:warrantyos@localhost:5432/warrantyos

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# --- AI / RocketRide ---
# "mock" needs no key and is what the hackathon demo uses out of the box.
# Switch to "rocketride" only once the real SDK is wired in (see /rocketrider/README.md).
ROCKETRIDE_MODE=mock
ROCKETRIDE_API_KEY=

# --- AI Execution (Part 2.4, offline mock) ---
AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_PIPELINE_VERSION=2.6
AI_EXECUTION_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=2

# --- AI Intelligence, Observability & Evaluation (Part 2.6, offline) ---
AI_FALLBACK_TO_MOCK=true
AI_OCR_PROVIDER=mock

AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_MODEL=mock-16
AI_EMBEDDING_DIMENSION=16

AI_VECTOR_STORE=memory
VECTOR_STORE=memory
PGVECTOR_COLLECTION=historical_cases

AI_POLICY_RETRIEVAL_TOP_K=5
AI_HISTORICAL_RETRIEVAL_TOP_K=5

AI_EVALUATION_ENABLED=true
AI_TELEMETRY_ENABLED=true


# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
